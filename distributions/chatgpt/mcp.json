{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pushman": {
      "type": "streamable-http",
      "url": "https://app.pushman.whitekiwi.link/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://app.pushman.whitekiwi.link/mcp",
            "baseScopes": [
              "push",
              "devices:read",
              "history:read",
              "usage:read",
              "sender:read",
              "sender:manage"
            ]
          }
        }
      }
    }
  }
}
